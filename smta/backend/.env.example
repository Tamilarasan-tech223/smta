# Rename this file to ".env". No API keys are needed anywhere in this
# file -- the live data sources are completely free:
#
#   - Mastodon   : public hashtag timeline (no auth required)
#   - Hacker News: Algolia's free search API (no auth required)
#   - Bluesky    : public AT Protocol post search (no auth required)
#   - DEV.to     : public articles-by-tag API (no auth required)
#
# Every API response is tagged "source": "live" or "source": "demo".
# If the live sources are unreachable, the app falls back to the bundled
# demo dataset automatically.

# --- Optional: use a different Mastodon instance (default mastodon.social) ---
MASTODON_INSTANCE=mastodon.social

# --- App config ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
DEMO_DATA_SIZE=600
